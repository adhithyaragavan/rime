### 2️⃣ The Commitment Binding — what gets sealed into the quote

[`packages/shared/src/reportdata.ts`](file:///c:/Users/Gupta/OneDrive/Desktop/rime/packages/shared/src/reportdata.ts)

```typescript
// Line 22-34: The commitment = keccak256(auditHash, agent, epoch)
export function buildCommitment(
  auditHash: Hex, agentAddress: Address, epoch: bigint
): Hex {
  return keccak256(
    encodeAbiParameters(
      parseAbiParameters("bytes32, address, uint64"),
      [auditHash, agentAddress, epoch]
    )
  );
}
```

**Key point:** This encoding MUST match the Solidity side byte-for-byte. If they diverge by even one byte, `certify()` reverts with `CommitmentMismatch`.

