### 3️⃣ The Attestation Flow — building and requesting the quote

[`packages/agent/src/attest.ts`](file:///c:/Users/Gupta/OneDrive/Desktop/rime/packages/agent/src/attest.ts)

```typescript
// Line 28-48: Builds commitment, requests hardware quote, cross-checks
export async function requestAttestation(
  provider: ConfigfsTsmQuoteProvider,
  auditHash: Hex, agentAddress: Address, epoch: bigint
): Promise<AttestationResult> {
  const commitment = buildCommitment(auditHash, agentAddress, epoch);
  // Right-pad to 64 bytes (TDX report_data field is fixed 64 bytes)
  const reportData = `${commitment}${"00".repeat(32)}` as Hex;
  const { quote } = await provider.getQuote(reportData);
  return { quote, commitment, parsedReportData: extractReportData(quote), epoch };
}
```

